                 << leaveRecords[i].type << "|"
                 << leaveRecords[i].status << "\n";

        file.close();
        cout << "\nLeave data saved to leaves.txt\n";
    }

    void loadLeaves() {
        ifstream file("leaves.txt");
        if (!file) return;

        string line;
        while (getline(file, line)) {
            if (line.empty()) continue;
            stringstream ss(line);
            string idStr, month, daysStr, type, status;
            getline(ss, idStr, '|');
            getline(ss, month, '|');
            getline(ss, daysStr, '|');
            getline(ss, type, '|');
            getline(ss, status, '|');

            int id = 0, days = 0;
            stringstream(idStr) >> id;
            stringstream(daysStr) >> days;
            if (findEmployee(id) == NULL || !validMonth(month) || days <= 0 ||
                (type != "Paid" && type != "Unpaid")) continue;

            LeaveRecord r(id, month, days, type);
            r.status = status.empty() ? "Pending" : status;
            leaveRecords.push_back(r);

            if (r.status == "Approved") {
                LeaveBalance& b = getLeaveBalance(id);
                if (r.type == "Paid" && r.days <= b.paidLeave) b.paidLeave -= r.days;
                else if (r.type == "Unpaid") b.unpaidLeave += r.days;
            }
        }
        file.close();
    }

    void employeePayslip() {
        int id = readInt("\nEnter Employee ID: ");
        Employee* e = findEmployee(id);

        if (e == NULL) {
            cout << "Employee not found.\n";
            return;
        }

        bool found = false;
        for (size_t i = 0; i < payrolls.size(); i++) {
            if (payrolls[i].employeeId == id) {
                cout << "\n========== MY PAYSLIP ==========\n";
                e->display();
                cout << endl;
                payrolls[i].salary.display();
                cout << "Payroll Month : " << payrolls[i].month << endl;
                cout << "Tax : Rs. " << fixed << setprecision(2) << payrolls[i].salary.getTax() << endl;
                cout << "Status : " << payrolls[i].status << endl;
                found = true;
            }
        }

        if (!found)
            cout << "\nNo payslip found.\n";
    }
};

